DATABASE_USERNAME=kitchenai
DATABASE_PASSWORD=kitchenai
JWT_SECRET=replace-with-at-least-32-random-characters
AI_PROVIDER=stub
AI_API_KEY=
AI_RECIPE_MODEL=
