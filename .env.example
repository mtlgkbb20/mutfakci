DATABASE_URL=jdbc:postgresql://localhost:5432/kitchenai
DATABASE_USERNAME=kitchenai
DATABASE_PASSWORD=kitchenai
JWT_SECRET=replace-with-at-least-32-random-characters
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
FRONTEND_URL=http://localhost:5173

# Runware provider (default profile; .env is loaded automatically by Spring Boot)
RUNWARE_API_KEY=
RUNWARE_MODEL=deepseek:v4.1@flash
RUNWARE_VISION_MODEL=google:gemini@3.1-pro
RUNWARE_TEXT_FALLBACK_MODEL=google:gemini@3.1-flash-lite
RUNWARE_NORMALIZER_MODEL=google:gemini@3.1-flash-lite
SPRING_PROFILES_ACTIVE=runware
MAX_IMAGE_SIZE=10MB

# Membership and payment provider selection. No prices or live checkout are enabled yet.
PAYMENT_PROVIDER=paytr
PAYMENT_CALLBACK_URL=https://your-domain.example/api/v1/payments/paytr/callback
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
