DATABASE_URL=jdbc:postgresql://localhost:5432/kitchenai
DATABASE_USERNAME=kitchenai
DATABASE_PASSWORD=kitchenai
JWT_SECRET=replace-with-at-least-32-random-characters
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
FRONTEND_URL=http://localhost:5173

# Runware provider
RUNWARE_API_KEY=
RUNWARE_MODEL=deepseek:v4.1@flash
RUNWARE_VISION_MODEL=google:gemini@3.1-pro
RUNWARE_TEXT_FALLBACK_MODEL=google:gemini@3.1-flash-lite
RUNWARE_NORMALIZER_MODEL=google:gemini@3.1-flash-lite
SPRING_PROFILES_ACTIVE=runware
MAX_IMAGE_SIZE=10MB

# PayTR iFrame checkout. Use test credentials from your PayTR merchant panel.
# Test mode is ON by default. Live payments require two explicit switches.
PAYMENT_PROVIDER=paytr
PAYMENT_CHECKOUT_ENABLED=false
PAYMENT_TEST_MODE=true
PAYMENT_LIVE_ENABLED=false
PAYMENT_CALLBACK_URL=https://YOUR_PUBLIC_HTTPS_HOST/api/v1/payments/paytr/callback
PAYMENT_RETURN_URL=http://localhost:5173/
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# Set this to your public IPv4 when testing from localhost/LAN, as required by PayTR.
PAYTR_TEST_USER_IP=

# Test-only example prices. These are not production pricing.
COOKER_MONTHLY_PRICE=1.00
COOKER_YEARLY_PRICE=2.00
