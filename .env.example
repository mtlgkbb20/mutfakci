# Copy this file to .env in the repository root for local development.
# Never commit .env or put real credentials in this template.

# Spring Boot
PORT=8080
SERVER_ADDRESS=0.0.0.0
SPRING_PROFILES_ACTIVE=runware
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRATION_MINUTES=60

# Database
# Local PostgreSQL fallback. Used when SUPABASE_DB_JDBC_URL is empty.
DATABASE_URL=jdbc:postgresql://localhost:5432/kitchenai
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> JDBC.
# Ensure the JDBC URL includes ?sslmode=require (or &sslmode=require if query params exist).
# Keep the username/password separate; do not paste credentials into this URL.
SUPABASE_DB_JDBC_URL=
DATABASE_USERNAME=kitchenai
DATABASE_PASSWORD=kitchenai

# AI provider (Runware)
RUNWARE_API_KEY=
RUNWARE_MODEL=deepseek:v4.1@flash
RUNWARE_VISION_MODEL=google:gemini@3.1-pro
RUNWARE_TEXT_FALLBACK_MODEL=google:gemini@3.1-flash-lite
RUNWARE_NORMALIZER_MODEL=google:gemini@3.1-flash-lite

# Upload limits
MAX_IMAGE_SIZE=10MB
MAX_IMAGE_REQUEST_SIZE=40MB

# Local media storage
STORAGE_LOCAL_PATH=./data/uploads
# Reserved for a future storage-adapter rollout; Supabase Storage is not enabled by this config.
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Membership and payment provider selection. No live checkout is enabled yet.
PAYMENT_PROVIDER=iyzico
PAYMENT_CALLBACK_URL=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=
# PayTR adapter is retained for future use; configure only when enabled.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
